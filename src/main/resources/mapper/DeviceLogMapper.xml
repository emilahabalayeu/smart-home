<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.solvd.smarthome.persistence.DeviceLogRepository">

    <select id="findAll" resultType="DeviceLog">
        SELECT * FROM device_logs
    </select>

    <select id="findById" resultType="DeviceLog" parameterType="Long">
        SELECT * FROM device_logs WHERE id = #{id}
    </select>

    <select id="findByDeviceId" resultType="DeviceLog" parameterType="Long">
        SELECT * FROM device_logs WHERE device_id = #{deviceId}
    </select>

    <insert id="create" parameterType="DeviceLog" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO device_logs (message, timestamp, device_id)
        VALUES (#{message}, #{timestamp}, #{deviceId})
    </insert>

    <update id="update" parameterType="DeviceLog">
        UPDATE device_logs SET
        message = #{message},
        timestamp = #{timestamp},
        device_id = #{deviceId}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="Long">
        DELETE FROM device_logs WHERE id = #{id}
    </delete>

</mapper>
